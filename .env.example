# 로컬 개발용 Postgres (compose.yaml, application-local.yml 공용)
# 복사해서 .env를 만들고 비밀번호를 바꾼다: cp .env.example .env
POSTGRES_DB=liveguard
POSTGRES_USER=liveguard
POSTGRES_PASSWORD=change-me
# 호스트 포트. 5432는 로컬에 설치된 Postgres와 겹치기 쉬워 5433을 쓴다
POSTGRES_PORT=5433

# /internal/** 서비스 토큰. Agent(liveguard-agent)와 같은 값을 쓴다. 값은 저장소에 넣지 않는다
INTERNAL_SERVICE_TOKEN=

# BE -> Agent HTTP delivery (independent of INTERNAL_SERVICE_TOKEN).
# No automatic chat enqueue; keep disabled until Agent/read APIs are ready.
AGENT_DELIVERY_ENABLED=false
AGENT_BASE_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=
