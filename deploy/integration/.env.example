# Private integration environment; copy to .env in this directory.
# Generate separate hexadecimal values (openssl rand -hex 24).
BE_DB_PASSWORD=
AGENT_DB_PASSWORD=
INTERNAL_SERVICE_TOKEN=
AGENT_SERVICE_TOKEN=
BUSINESS_MCP_AGENT_TOKEN=
RAG_MCP_AGENT_TOKEN=

# Policy version shared by BE and Agent (A-27). Stays v3.1 until the coordinated v3.2 cutover;
# set v3.2 only with an Agent build that supports it and RAG indexed with v3.2 (keep the v3.1 index).
LIVEGUARD_POLICY_VERSION=v3.1

# Container-reachable RAG MCP, indexed with the policy version above.
# RAG deployment/indexing remains Agent/Infra-owned; do not point to localhost.
RAG_MCP_URL=

# Choose a trusted controlled OpenAI-compatible endpoint OR a real provider.
# Never use production chat data for a controlled-model test.
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_QUOTA_GROUP=
MODEL_RPM=30
MODEL_TPM=60000
MODEL_CONCURRENCY=4
MODEL_MAX_INPUT_TOKENS=12000
MODEL_MAX_OUTPUT_TOKENS=2000
MODEL_TIMEOUT_SECONDS=30

# Host-only ports; API/MCP replicas and databases are not published.
BE_PORT=18080
AGENT_PORT=18001
BUSINESS_MCP_PORT=18002

# Used only with the explicit rabbit overlay.
RABBITMQ_PASSWORD=
